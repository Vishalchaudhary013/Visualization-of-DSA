# Copy to .env and fill in. .env is gitignored: never commit real values.

# MongoDB connection string (e.g. from MongoDB Atlas). Without it the app runs,
# but sign up / log in / history are disabled.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign login sessions. Required in production; use a long
# random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional
# PORT=8080
